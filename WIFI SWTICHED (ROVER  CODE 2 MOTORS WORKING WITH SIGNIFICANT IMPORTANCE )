#include <WiFi.h>
#include <WiFiUdp.h>

// =====================================================
// WIFI
// =====================================================

const char* SSID = "ROVER_REMOTE";
const char* PASSWORD = "rover1234";

WiFiUDP udp;

const unsigned int UDP_PORT = 4210;

// =====================================================
// MOTOR DRIVER — LEFT SIDE
// =====================================================

#define LEFT_RPWM 25
#define LEFT_LPWM 26

#define LEFT_REN 32
#define LEFT_LEN 33

// =====================================================
// DATA
// =====================================================

int throttle = 0;
int steering = 0;
int button = 0;

unsigned long lastPacket = 0;

#define SIGNAL_TIMEOUT 500

// =====================================================
// STOP MOTOR
// =====================================================

void stopLeftMotor() {

  ledcWrite(LEFT_RPWM, 0);
  ledcWrite(LEFT_LPWM, 0);
}

// =====================================================
// DRIVE LEFT MOTOR
// =====================================================

void driveLeftMotor(int speed) {

  speed = constrain(speed, -255, 255);

  // IDLE
  if (speed == 0) {

    ledcWrite(LEFT_RPWM, 0);
    ledcWrite(LEFT_LPWM, 0);

    return;
  }

  // FORWARD
  if (speed > 0) {

    ledcWrite(
      LEFT_RPWM,
      speed
    );

    ledcWrite(
      LEFT_LPWM,
      0
    );
  }

  // REVERSE
  else {

    ledcWrite(
      LEFT_RPWM,
      0
    );

    ledcWrite(
      LEFT_LPWM,
      abs(speed)
    );
  }
}

// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("==============================");
  Serial.println("     ALL TERRAIN ROVER");
  Serial.println("        ROVER ESP32");
  Serial.println("==============================");

  // ===================================================
  // MOTOR PINS
  // ===================================================

  pinMode(LEFT_REN, OUTPUT);
  pinMode(LEFT_LEN, OUTPUT);

  digitalWrite(LEFT_REN, HIGH);
  digitalWrite(LEFT_LEN, HIGH);

  // PWM
  ledcAttach(
    LEFT_RPWM,
    1000,
    8
  );

  ledcAttach(
    LEFT_LPWM,
    1000,
    8
  );

  stopLeftMotor();

  // ===================================================
  // WIFI
  // ===================================================

  WiFi.mode(WIFI_STA);

  WiFi.begin(SSID, PASSWORD);

  Serial.print("Connecting to ");
  Serial.println(SSID);

  while (WiFi.status() != WL_CONNECTED) {

    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WIFI CONNECTED!");

  Serial.print("ROVER IP: ");
  Serial.println(WiFi.localIP());

  Serial.print("REMOTE IP: ");
  Serial.println(WiFi.gatewayIP());

  // ===================================================
  // UDP
  // ===================================================

  udp.begin(UDP_PORT);

  Serial.print("UDP PORT: ");
  Serial.println(UDP_PORT);

  Serial.println("ROVER READY");
}

// =====================================================
// LOOP
// =====================================================

void loop() {

  int packetSize = udp.parsePacket();

  if (packetSize > 0) {

    char packet[50];

    int len = udp.read(
      packet,
      sizeof(packet) - 1
    );

    if (len > 0) {
      packet[len] = '\0';
    }

    // Format:
    // throttle,steering,button

    sscanf(
      packet,
      "%d,%d,%d",
      &throttle,
      &steering,
      &button
    );

    lastPacket = millis();

    // =================================================
    // CURRENTLY LEFT SIDE ONLY
    // =================================================

    driveLeftMotor(throttle);

    // =================================================
    // DEBUG
    // =================================================

    Serial.print("Throttle: ");
    Serial.print(throttle);

    Serial.print(" | Steering: ");
    Serial.print(steering);

    Serial.print(" | Button: ");
    Serial.println(
      button ? "PRESSED" : "RELEASED"
    );
  }

  // ===================================================
  // FAILSAFE
  // ===================================================

  if (millis() - lastPacket > SIGNAL_TIMEOUT) {

    stopLeftMotor();
  }

  delay(5);
}
