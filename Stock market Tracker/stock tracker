
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// WiFi Details
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// OLED Setup
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// NIFTY 50 API
const char* url =
"https://query1.finance.yahoo.com/v8/finance/chart/%5ENSEI?range=1d&interval=1m";

float nifty = 0;
float previousClose = 0;
float lastPrice = 0;

void connectWiFi() {

  WiFi.begin(ssid, password);

  display.clearDisplay();
  display.setCursor(0, 20);
  display.println("Connecting WiFi...");
  display.display();

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }
}

void getNiftyData() {

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient https;

  if (https.begin(client, url)) {

    int httpCode = https.GET();

    if (httpCode == 200) {

      String payload = https.getString();

      JsonDocument doc;

      DeserializationError error =
      deserializeJson(doc, payload);

      if (!error) {

        nifty = doc["chart"]["result"][0]
        ["meta"]["regularMarketPrice"] | 0.0;

        previousClose = doc["chart"]["result"][0]
        ["meta"]["chartPreviousClose"] | 0.0;

        Serial.print("NIFTY: ");
        Serial.println(nifty);

      }
    }

    https.end();
  }
}

void showDisplay() {

  float change = nifty - previousClose;
  float percentage = (change / previousClose) * 100;

  display.clearDisplay();

  display.setTextColor(WHITE);

  // Title
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("NED-OS | MARKET");

  display.drawLine(0, 12, 128, 12, WHITE);

  // NIFTY value
  display.setTextSize(2);
  display.setCursor(0, 18);
  display.print("NIFTY 50");

  display.setTextSize(2);
  display.setCursor(0, 38);
  display.print(nifty, 2);

  // Direction
  display.setTextSize(1);
  display.setCursor(0, 56);

  if (change > 0) {
    display.print("UP +");
  }
  else if (change < 0) {
    display.print("DOWN ");
  }
  else {
    display.print("UNCHANGED ");
  }

  display.print(change, 2);
  display.print(" (");
  display.print(percentage, 2);
  display.print("%)");

  display.display();
}

void setup() {

  Serial.begin(115200);

  Wire.begin(8, 9); // SDA, SCL for common ESP32-C3 boards

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED not found!");
    while (true);
  }

  display.clearDisplay();
  display.setTextColor(WHITE);
  display.setCursor(0, 20);
  display.println("NED-OS STOCK TRACKER");
  display.display();

  connectWiFi();

  delay(1000);
}

void loop() {

  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  getNiftyData();

  if (nifty > 0 && previousClose > 0) {
    showDisplay();
  }

  delay(5000);
}
