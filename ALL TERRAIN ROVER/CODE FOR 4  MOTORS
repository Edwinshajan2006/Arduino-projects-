#include <WiFi.h>
#include <WiFiUdp.h>

// =====================================================
// WIFI
// =====================================================

const char* SSID = "ROVER_REMOTE";
const char* PASSWORD = "rover1234";

WiFiUDP udp;

const unsigned int UDP_PORT = 4210;


// =====================================================
// DRIVER 1 — LEFT SIDE
// FRONT LEFT + REAR LEFT
// =====================================================

#define LEFT_RPWM 25
#define LEFT_LPWM 26

#define LEFT_REN 32
#define LEFT_LEN 33


// =====================================================
// DRIVER 2 — RIGHT SIDE
// FRONT RIGHT + REAR RIGHT
// =====================================================

#define RIGHT_RPWM 18
#define RIGHT_LPWM 19

#define RIGHT_REN 27
#define RIGHT_LEN 14


// =====================================================
// PWM SETTINGS
// =====================================================

#define PWM_FREQUENCY 1000
#define PWM_RESOLUTION 8


// =====================================================
// CONTROL VALUES
// =====================================================

int throttle = 0;
int steering = 0;
int button = 0;

unsigned long lastPacket = 0;

#define SIGNAL_TIMEOUT 500


// =====================================================
// STOP LEFT DRIVER
// =====================================================

void stopLeft() {

  ledcWrite(
    LEFT_RPWM,
    0
  );

  ledcWrite(
    LEFT_LPWM,
    0
  );
}


// =====================================================
// STOP RIGHT DRIVER
// =====================================================

void stopRight() {

  ledcWrite(
    RIGHT_RPWM,
    0
  );

  ledcWrite(
    RIGHT_LPWM,
    0
  );
}


// =====================================================
// STOP EVERYTHING
// =====================================================

void stopMotors() {

  stopLeft();
  stopRight();
}


// =====================================================
// DRIVE LEFT DRIVER
// =====================================================

void driveLeft(int speed) {

  speed = constrain(
    speed,
    -255,
    255
  );

  // Stop
  if (speed == 0) {

    stopLeft();

    return;
  }

  // Forward
  if (speed > 0) {

    ledcWrite(
      LEFT_RPWM,
      speed
    );

    ledcWrite(
      LEFT_LPWM,
      0
    );
  }

  // Reverse
  else {

    ledcWrite(
      LEFT_RPWM,
      0
    );

    ledcWrite(
      LEFT_LPWM,
      abs(speed)
    );
  }
}


// =====================================================
// DRIVE RIGHT DRIVER
// =====================================================

void driveRight(int speed) {

  speed = constrain(
    speed,
    -255,
    255
  );

  // Stop
  if (speed == 0) {

    stopRight();

    return;
  }

  // Forward
  if (speed > 0) {

    ledcWrite(
      RIGHT_RPWM,
      speed
    );

    ledcWrite(
      RIGHT_LPWM,
      0
    );
  }

  // Reverse
  else {

    ledcWrite(
      RIGHT_RPWM,
      0
    );

    ledcWrite(
      RIGHT_LPWM,
      abs(speed)
    );
  }
}


// =====================================================
// DIFFERENTIAL DRIVE
// =====================================================

void driveRover(
  int throttleValue,
  int steeringValue
) {

  // ===================================================
  // CENTER / IDLE
  // ===================================================

  if (
    throttleValue == 0 &&
    steeringValue == 0
  ) {

    stopMotors();

    return;
  }


  // ===================================================
  // DIFFERENTIAL MIXING
  // ===================================================

  int leftSpeed =
    throttleValue + steeringValue;

  int rightSpeed =
    throttleValue - steeringValue;


  // ===================================================
  // LIMIT
  // ===================================================

  leftSpeed = constrain(
    leftSpeed,
    -255,
    255
  );

  rightSpeed = constrain(
    rightSpeed,
    -255,
    255
  );


  // ===================================================
  // DRIVE
  // ===================================================

  driveLeft(leftSpeed);

  driveRight(rightSpeed);
}


// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("==============================");
  Serial.println("      ALL TERRAIN ROVER");
  Serial.println("        ROVER ESP32");
  Serial.println("==============================");


  // ===================================================
  // LEFT DRIVER ENABLE
  // ===================================================

  pinMode(
    LEFT_REN,
    OUTPUT
  );

  pinMode(
    LEFT_LEN,
    OUTPUT
  );


  // ===================================================
  // RIGHT DRIVER ENABLE
  // ===================================================

  pinMode(
    RIGHT_REN,
    OUTPUT
  );

  pinMode(
    RIGHT_LEN,
    OUTPUT
  );


  // Enable both drivers
  digitalWrite(
    LEFT_REN,
    HIGH
  );

  digitalWrite(
    LEFT_LEN,
    HIGH
  );

  digitalWrite(
    RIGHT_REN,
    HIGH
  );

  digitalWrite(
    RIGHT_LEN,
    HIGH
  );


  // ===================================================
  // PWM
  // ===================================================

  ledcAttach(
    LEFT_RPWM,
    PWM_FREQUENCY,
    PWM_RESOLUTION
  );

  ledcAttach(
    LEFT_LPWM,
    PWM_FREQUENCY,
    PWM_RESOLUTION
  );

  ledcAttach(
    RIGHT_RPWM,
    PWM_FREQUENCY,
    PWM_RESOLUTION
  );

  ledcAttach(
    RIGHT_LPWM,
    PWM_FREQUENCY,
    PWM_RESOLUTION
  );


  // Start stopped
  stopMotors();


  // ===================================================
  // WIFI
  // ===================================================

  WiFi.mode(WIFI_STA);

  WiFi.begin(
    SSID,
    PASSWORD
  );

  Serial.print("Connecting to ");
  Serial.println(SSID);


  while (
    WiFi.status() != WL_CONNECTED
  ) {

    delay(500);

    Serial.print(".");
  }


  Serial.println();
  Serial.println("WIFI CONNECTED!");

  Serial.print("ROVER IP: ");
  Serial.println(
    WiFi.localIP()
  );

  Serial.print("REMOTE IP: ");
  Serial.println(
    WiFi.gatewayIP()
  );


  // ===================================================
  // UDP
  // ===================================================

  udp.begin(
    UDP_PORT
  );

  Serial.print("UDP PORT: ");
  Serial.println(UDP_PORT);

  Serial.println("ROVER READY");
}


// =====================================================
// LOOP
// =====================================================

void loop() {

  int packetSize =
    udp.parsePacket();


  if (packetSize > 0) {

    char packet[50];

    int len =
      udp.read(
        packet,
        sizeof(packet) - 1
      );

    if (len > 0) {

      packet[len] = '\0';
    }


    // Format:
    // throttle,steering,button

    sscanf(
      packet,
      "%d,%d,%d",
      &throttle,
      &steering,
      &button
    );


    lastPacket = millis();


    // =================================================
    // DRIVE BOTH SIDES
    // =================================================

    driveRover(
      throttle,
      steering
    );


    // =================================================
    // DEBUG
    // =================================================

    Serial.print("Throttle: ");
    Serial.print(throttle);

    Serial.print(" | Steering: ");
    Serial.print(steering);

    Serial.print(" | Left: ");
    Serial.print(
      throttle + steering
    );

    Serial.print(" | Right: ");
    Serial.println(
      throttle - steering
    );
  }


  // ===================================================
  // FAILSAFE
  // ===================================================

  if (
    millis() - lastPacket >
    SIGNAL_TIMEOUT
  ) {

    stopMotors();
  }


  delay(5);
}
