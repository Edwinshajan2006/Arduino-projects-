#include "BluetoothA2DPSource.h"

BluetoothA2DPSource a2dp_source;

uint8_t tws_mac[] = {
  0x28, 0x04, 0xC6,
  0x64, 0x9E, 0x34
};

// ============================================================
// 440 Hz TEST TONE
// ============================================================

const int SAMPLE_RATE = 44100;
const float FREQUENCY = 440.0;
const int AMPLITUDE = 4000;

float phase = 0.0;
const float phase_increment =
    2.0 * PI * FREQUENCY / SAMPLE_RATE;

// Generate stereo audio
int32_t get_audio_data(Frame *frame, int32_t frame_count) {

  for (int i = 0; i < frame_count; i++) {

    int16_t sample =
        (int16_t)(AMPLITUDE * sin(phase));

    frame[i].channel1 = sample;
    frame[i].channel2 = sample;

    phase += phase_increment;

    if (phase >= 2.0 * PI) {
      phase -= 2.0 * PI;
    }
  }

  return frame_count;
}

// ============================================================
// CONNECTION STATUS
// ============================================================

void connection_callback(
    esp_a2d_connection_state_t state,
    void *obj) {

  if (state == ESP_A2D_CONNECTION_STATE_CONNECTED) {
    Serial.println("CONNECTED SUCCESSFULLY");
    Serial.println("PLAYING 440 Hz TEST TONE");
  }
  else if (state == ESP_A2D_CONNECTION_STATE_DISCONNECTED) {
    Serial.println("DISCONNECTED");
  }
  else {
    Serial.println("CONNECTING...");
  }
}

// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("==============================");
  Serial.println(" ESP32 -> TWS AUDIO TEST");
  Serial.println("==============================");

  a2dp_source.set_data_callback_in_frames(
      get_audio_data
  );

  a2dp_source.set_on_connection_state_changed(
      connection_callback
  );

  a2dp_source.set_auto_reconnect(
      tws_mac,
      5
  );

  Serial.println("Starting A2DP...");

  a2dp_source.start();
}

// ============================================================
// LOOP
// ============================================================

void loop() {
}
